#!/usr/bin/env bash
set -euo pipefail

name="${1:-}"
if [[ -z "$name" ]]; then
  echo "Usage: devtmux <project-or-session-name>" >&2
  exit 2
fi

session="$(basename "$name" | tr '. :' '---')"
dir="$PWD"

if [[ -d "$name" ]]; then
  dir="$(cd "$name" && pwd)"
else
  for root in "$HOME/project" "$HOME/Developer" "$HOME/Projects" "$HOME/Code" "$HOME/Workspace"; do
    [[ -d "$root/$name" ]] && dir="$root/$name" && break
  done
fi

if tmux has-session -t "$session" 2>/dev/null; then
  exec tmux attach-session -t "$session"
fi

tmux new-session -d -s "$session" -c "$dir" -n editor
tmux send-keys -t "$session:editor" 'nvim .' C-m
tmux split-window -v -t "$session:editor" -c "$dir" -l 35%
tmux split-window -h -t "$session:editor.2" -c "$dir" -p 35
tmux select-pane -t "$session:editor.1"
tmux new-window -t "$session" -n git -c "$dir"
tmux send-keys -t "$session:git" 'git status --short 2>/dev/null || true' C-m
tmux select-window -t "$session:editor"
exec tmux attach-session -t "$session"
